OPENAI_API_KEY=insert-api-key-here
OPENAI_JUDGE_MODEL=insert-model-name-here
# Optional; the interactive demo falls back to OPENAI_JUDGE_MODEL.
OPENAI_AGENT_MODEL=insert-model-name-here
# Configure these for the exact judge model, prompt, and deployment traffic you use.
# The recorded Terra benchmarks selected 0.95 for feedback and 0.70 for prompt routing;
# those values are evidence for that benchmark only, not universal defaults.
ADAPTKIT_IMPLICIT_CONFIDENCE_THRESHOLD=insert-calibrated-threshold
ADAPTKIT_PROMPT_CONFIDENCE_THRESHOLD=insert-calibrated-threshold
